# Firebase web configuration for the `cerion-platform` project.
# These values are publishable (access is enforced by Firebase security rules).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=cerion-platform
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APP_CHECK_SITE_KEY=
# Local development only. Never set this to true in Vercel Production.
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=false
